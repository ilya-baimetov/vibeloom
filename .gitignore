.DS_Store
.wrangler/

# Local agent outputs (one-off pitch / artifact runs that don't belong in git)
outputs/

# Python build artifacts
__pycache__/
*.pyc

# NOTE: v03's extracted skill surface (SKILL.md, subagent-prompt.md, references/,
# tasks/, artifacts/) is deliberately NOT ignored. It is the installable surface —
# a clone has to contain it or the skill cannot be loaded from the repo at all.
# vibeloom-templates.md stays canonical; `extract-templates.py --check` is the
# CI guard that proves source and committed output never drift.

# Release-asset staging (tarballs go to GitHub releases, not into git)
dist/

# build-bundle.sh leaves a pointer to its last /tmp staging dir
.last-bundle-staging.txt

# Local-only announcement drafts (not for github)
/announcement-*.md

# Ephemeral eval/feedback outputs (vibeloom-dev)
/reports/

# Version-agnostic marketing material (not tracked)
/pitch-deck/

# Per-version release artifacts (rebuildable from source)
/v*/dist/

# Local-only business docs (not for github)
/investor-inbound-filter.md
/program-proposal-ai-code-governance-practice.md
/validation-ai-first-transformation-consulting.md
